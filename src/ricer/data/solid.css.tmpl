
/* top bar: one solid, readable strip edge to edge */
#panel {
  background-color: rgba($card_rgb, $card_alpha);
  height: ${panel_height}px;
  font-weight: 500;
}
#panel .panel-button { color: $text; }
#panel .panel-button:active, #panel .panel-button:checked,
#panel .panel-button:overview, #panel .panel-button:focus {
  box-shadow: none;
  background-color: rgba($accent2_rgb, 0.28);
}
