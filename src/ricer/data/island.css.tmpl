
/* top bar: one floating piece, clear of the screen edges */
#panel {
  background-color: rgba($card_rgb, $bar_alpha);
  border: 1px solid $border;
  border-radius: ${radius}px;
  margin: 7px 12px 3px 12px;
  height: ${island_height}px;
  font-weight: 500;
}
#panel:overview, #panel.unlock-screen, #panel.login-screen {
  background-color: rgba($card_rgb, $bar_alpha);
}
#panel .panel-button {
  color: $text;
  border-radius: ${button_radius}px;
  margin: 3px 1px;
  box-shadow: none;
  background-color: transparent;
}
#panel .panel-button:hover {
  box-shadow: none;
  background-color: rgba(255, 255, 255, 0.10);
}
#panel .panel-button:active, #panel .panel-button:checked,
#panel .panel-button:overview, #panel .panel-button:focus {
  box-shadow: none;
  background-color: rgba($accent2_rgb, 0.28);
}
