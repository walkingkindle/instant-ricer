
/* top bar: no background at all, just text over the wallpaper */
#panel {
  background-color: transparent;
  height: ${slim_height}px;
  font-weight: 600;
}
#panel:overview, #panel.unlock-screen, #panel.login-screen {
  background-color: transparent;
}
#panel .panel-button {
  color: $text;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
  border-radius: ${button_radius}px;
  box-shadow: none;
  background-color: transparent;
}
#panel .panel-button .system-status-icon { icon-shadow: 0 1px 4px rgba(0, 0, 0, 0.8); }
#panel .panel-button:hover {
  box-shadow: none;
  background-color: rgba(255, 255, 255, 0.12);
}
#panel .panel-button:active, #panel .panel-button:checked,
#panel .panel-button:overview, #panel .panel-button:focus {
  box-shadow: none;
  background-color: rgba($accent2_rgb, 0.28);
}
