/* Generated by ricer. Do not edit: every 'ricer instant' rewrites this file. */
@import $base_import;

#panel { font-size: ${font_size}pt; }

/* clock in the accent colour */
#panel .clock-display .clock {
  color: $accent;
  font-weight: 600;
  letter-spacing: 1px;
  box-shadow: none;
  background-color: transparent;
}

/* workspace indicator in the accent, as a gradient when the look has one */
#panel .workspace-dot {
  background-gradient-direction: horizontal;
  background-gradient-start: $accent;
  background-gradient-end: $accent_end;
}

/* menus opened from the bar: the same card as the widgets */
.popup-menu-content, .quick-settings, .candidate-popup-content {
  background-color: rgba($card_rgb, 0.92);
  border: 1px solid $border;
  border-radius: ${menu_radius}px;
}
#calendarArea, .datemenu-popover { border-radius: ${menu_radius}px; }

.quick-toggle:checked, .quick-menu-toggle .quick-toggle:checked,
.quick-menu-toggle .quick-toggle-arrow:checked {
  color: $card;
  background-gradient-direction: horizontal;
  background-gradient-start: $accent;
  background-gradient-end: $accent_end;
}
.slider {
  -barlevel-active-background-color: $accent;
  -slider-handle-border-color: $accent;
}
.calendar .calendar-today, .calendar .calendar-today:selected {
  color: $card;
  background-color: $accent;
}
